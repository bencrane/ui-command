# Supabase Database Configuration
# These environment variables should be provided by your cloud environment

# Supabase host (without https://)
SUBSTRATE_RA_HOST=your-project.supabase.co

# Database connection details
SUBSTRATE_RA_PORT=5432
SUBSTRATE_RA_DATABASE=postgres
SUBSTRATE_RA_USER=postgres
SUBSTRATE_RA_PASSWORD=your-password

# Supabase API keys
SUBSTRATE_RA_PUBLISHABLE_KEY=your-publishable-key
SUBSTRATE_RA_SECRET_KEY=your-secret-key
SUBSTRATE_RA_SERVICE_ROLE_KEY=your-service-role-key

# GitHub Campaigns Configuration
# Base URL for campaign config files (without trailing slash before campaign key)
# Example: https://raw.githubusercontent.com/username/repo/main/campaigns/
GITHUB_CAMPAIGNS_BASE_URL=https://raw.githubusercontent.com/username/repo/main/campaigns/

# Pipedream Campaign Staging Endpoint
# The webhook URL where selected contacts will be POSTed for campaign staging
CAMPAIGN_STAGING_PIPEDREAM_ENDPOINT_URL=https://your-pipedream-endpoint.m.pipedream.net
